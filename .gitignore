# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Go build output (bootstrap compiles it on Kaggle)
go/gateway/gateway
tools_bin/
*.test

# Rust
rust/audio_rt/target/
**/*.so

# Node (dev tooling and STM32 workbench server)
node_modules/

# Runtime state
qtts/
state/
*.log
.DS_Store

# STM32 workbench runtime data. Source code remains trackable; potentially
# large reference videos and the local audit log stay out of Git by default.
stm32/project/videos/*
!stm32/project/videos/.gitkeep
stm32/project/.workspace/
